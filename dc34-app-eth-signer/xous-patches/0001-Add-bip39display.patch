+use super::*;
+use crate::minigfx::*;
+use crate::widgets::ScrollableList;
+
+/// Read-only, scrollable display of a BIP-39 phrase. The word list is rendered with
+/// one numbered word per row inside a `ScrollableList` (the same widget that backs
+/// `Bip39Entry`'s word picker), so phrases that don't fit on small screens can be
+/// scrolled through with the arrow keys instead of overflowing into the dismissal
+/// affordance. Any non-arrow key dismisses the modal.
+pub struct Bip39Display {
+    pub items: ScrollableList,
+    pub action_conn: xous::CID,
+    pub action_opcode: u32,
+}
+
+impl Bip39Display {
+    pub fn new(action_conn: xous::CID, action_opcode: u32) -> Self {
+        let mut items = ScrollableList::default();
+        items.set_margin(Point::new(4, 0));
+        Bip39Display { items, action_conn, action_opcode }
+    }
+
+    pub fn set_words(&mut self, words: &[String]) {
+        self.items.clear();
+        for (index, word) in words.iter().enumerate() {
+            self.items.add_item(0, &format!("{:2} {}", index + 1, word));
+        }
+    }
+}
+
+use crate::widgets::ActionApi;
+impl ActionApi for Bip39Display {
+    fn height(&self, _glyph_height: isize, _margin: isize, _modal: &Modal) -> isize {
+        // the word list claims the entire canvas below the caption
+        crate::minigfx::op::HEIGHT
+    }
+
+    fn redraw(&self, at_height: isize, _modal: &Modal) {
+        // ScrollableList repaints its own pane, so no explicit clearing is needed here
+        self.items.draw(at_height);
+    }
+
+    fn key_action(&mut self, k: char) -> Option<ValidatorErr> {
+        log::trace!("key_action: {}", k);
+        match k {
+            '\u{0}' => {
+                // ignore null messages
+            }
+            '↑' | '↓' | '←' | '→' => {
+                self.items.key_action(k);
+            }
+            _ => {
+                // relinquish focus before returning the result
+                self.items.gfx.release_modal().unwrap();
+                xous::yield_slice();
+
+                xous::send_message(
+                    self.action_conn,
+                    xous::Message::new_scalar(self.action_opcode as usize, k as u32 as usize, 0, 0, 0),
+                )
+                .expect("couldn't pass on dismissal");
+            }
+        }
+        None
+    }
+
+    fn set_action_opcode(&mut self, op: u32) { self.action_opcode = op }
+}
