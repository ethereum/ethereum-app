+    /// Blocking notification whose body is shown one line per row in a scrollable
+    /// list: the arrow keys scroll, any other key dismisses. Use this instead of
+    /// `show_notification` whenever the text may be taller than the screen.
+    pub fn show_scrollable(&self, caption: Option<&str>, text: &str) -> Result<(), xous::Error> {
+        self.lock();
+        let spec = ManagedScrollable {
+            token: self.token,
+            caption: caption.map(String::from),
+            text: String::from(text),
+        };
+        let buf = Buffer::into_buf(spec).or(Err(xous::Error::InternalError))?;
+        buf.lend(self.conn, Opcode::ScrollableNotification.to_u32().unwrap())
+            .or(Err(xous::Error::InternalError))?;
+        self.unlock();
+        Ok(())
+    }
+
     /// Modal dialog used to show up to 256 bits of `data` in bip39 format.
     ///
     /// - This dialog blocks until the notification has been acknowledged via [ Press any key ].
