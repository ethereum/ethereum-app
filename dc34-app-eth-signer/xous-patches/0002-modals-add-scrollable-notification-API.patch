From 4a20e5b81d06d7e8505ca3a0b0333e2464e79eea Mon Sep 17 00:00:00 2001
From: BTChip github <contact@btchip.com>
Date: Sun, 16 Aug 2026 19:28:23 +0000
Subject: [PATCH 2/2] modals: add scrollable notification API

New Modals::show_scrollable(caption, text): a blocking notification whose
body is rendered one line per row in a scrollable list (arrow keys
scroll, any other key dismisses), for content that may be taller than
the screen. Reuses the Bip39Display action (new set_lines method, no
numbering) on baosec targets; gam targets fall back to a plain inline
notification.
---
 libs/ux-api/src/widgets/bip39display.rs |  9 ++++
 services/modals/src/api.rs              | 10 ++++
 services/modals/src/lib.rs              | 17 +++++++
 services/modals/src/main.rs             | 66 ++++++++++++++++++++++++-
 4 files changed, 101 insertions(+), 1 deletion(-)

diff --git a/libs/ux-api/src/widgets/bip39display.rs b/libs/ux-api/src/widgets/bip39display.rs
index 0a0137f96..3f9aa0369 100644
--- a/libs/ux-api/src/widgets/bip39display.rs
+++ b/libs/ux-api/src/widgets/bip39display.rs
@@ -26,6 +26,15 @@ impl Bip39Display {
             self.items.add_item(0, &format!("{:2} {}", index + 1, word));
         }
     }
+
+    /// Arbitrary lines, without the bip39 numbering; used for any content that
+    /// may be taller than the screen (e.g. scrollable notifications).
+    pub fn set_lines<'a>(&mut self, lines: impl IntoIterator<Item = &'a str>) {
+        self.items.clear();
+        for line in lines {
+            self.items.add_item(0, line);
+        }
+    }
 }
 
