import { Navigate } from "gen/navigate.slint";

export enum SignTxState {
    Idle,
    Verifying,
    Sign,
    Signing,
    Success,
    Error,
}

// A decoded eth-sign-request transaction, pre-formatted by Rust.
export struct EthTxView {
    from: string,
    to: string,
    // False for contract creation, where `to` is a plain label.
    to-is-address: bool,
    chain-id: string,
    amount: string,
    max-fees: string,
    tx-type: string,
    origin: string,
    has-data: bool,
    // ERC-8213 calldata digest (0x…), empty without data.
    data-digest: string,
    // True for an EIP-8141 frame transaction; the sign page then shows the
    // full frame/signature breakdown from `frame-details`.
    is-frame: bool,
    // Pre-rendered breakdown of every frame and signature entry (with
    // explicit-digest warnings), produced by signer_displaying in Rust.
    frame-details: string,
}

// A decoded eth-sign-request EIP-712 typed-data message, pre-formatted by
// Rust, with the three ERC-8213 hashes.
export struct EthTypedDataView {
    // Pretty-printed JSON of the typed data.
    json: string,
    eip712-digest: string,
    domain-hash: string,
    message-hash: string,
    origin: string,
}

// A decoded eth-sign-request EIP-191 personal message.
export struct EthMessageView {
    // The message text, or its hex encoding when not displayable.
    text: string,
    // False when the raw bytes are not cleanly displayable (shown as hex,
    // with a warning).
    displayable: bool,
    // ERC-8213 EIP-191 Digest (0x…).
    eip191-digest: string,
    origin: string,
}

export enum SignRequestKind {
    Transaction,
    TypedData,
    Message,
}

export global SignTx {
    in property <SignTxState> state;
    // Which confirmation layout the sign page shows.
    in property <SignRequestKind> kind;
    in property <EthTxView> pending-tx;
    in property <EthTypedDataView> pending-typed-data;
    in property <EthMessageView> pending-message;
    // Shown on the error page (invalid QR, unsupported type, wrong key, ...).
    in property <string> error-message;
    // Single-part "ur:eth-signature/..." shown as a QR after signing.
    in property <string> signature-ur;

    callback cancel-signing();
    callback sign-tx();

    public function done() {
        self.cancel-signing();
        Navigate.backward();
    }
}
