export struct SingleSigView {
    account-number: int,
    fingerprint: string,
    public-key: string,
}

export struct AccountView {
    id: string,
    name: string,
    // EIP-55 address m/44'/60'/j'/0/0: the face of the account, and the seed
    // of its Jazzicon. Empty until the wallet's keys are derived.
    address: string,
    archived: bool,

    single: SingleSigView,
}

export global Callbacks {
    callback scan-clicked();
    // False while the active wallet owns no account (active or archived):
    // there is nothing a sign request could be matched against.
    in property <bool> can-scan: false;
    // Master fingerprint of the active wallet, upper case; empty until its
    // keys are derived.
    in property <string> fingerprint;

    in-out property <[AccountView]> accounts: [];
    pure callback account-details(account-id: string) -> AccountView;
    pure callback account-addresses(account-id: string) -> [string];

    callback update-account-name(account-id: string, name: string);

    public function set-archive-mode(mode: bool) {
        self.set-archive-mode-inner(mode);
        self.archive-mode = mode;
    }

    callback set-archive-mode-inner(bool);
    in-out property <bool> archive-mode;

    callback update-account-archived(account-id: string, archived: bool);
    callback delete-account(account-id: string);
}
