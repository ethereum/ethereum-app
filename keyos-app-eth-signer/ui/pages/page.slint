// Home: the wallet this app signs for and its accounts. Scanning a request is
// the app's main job, so it is the one primary button; everything else about
// an account lives on its own page, one tap away.

import { Theme, Images, ButtonVariant, ControlSize } from "@ui/theme.slint";
import { Button } from "@ui/button.slint";
import { IconButton, IconButtonVariant } from "@ui/icon_button.slint";
import { Chip, ChipVariant, ChipColor, ChipSize } from "@ui/chip.slint";
import { Menu, MenuRow } from "@ui/menu.slint";
import { MenuItem } from "@ui/menu_item.slint";
import { Sheet } from "@ui/sheet.slint";
import { Dialog } from "@ui/dialog.slint";
import { Checkbox } from "@ui/checkbox.slint";
import { SegmentedControl } from "@ui/segmented_control.slint";
import { TR2, TrId } from "../gen/tr.slint";
import { Navigate } from "../gen/navigate.slint";
import { AccountView, Callbacks } from "../callbacks.slint";
import { EnterPassphrase } from "../enter-passphrase.slint";
import { Settings, SeedSourceKind } from "../settings.slint";
import { Page, PageHeader, HeaderAction, ScrollArea } from "../components/layout.slint";
import { Mono, Eyebrow, MutedText, Jazzicon, ShortAddressText, EthGlyph } from "../components/eth-widgets.slint";

component AccountRow inherits MenuRow {
    in property <AccountView> account;

    interactive: true;
    content-padding-horizontal: Theme.spacing-lg;
    content-padding-vertical: 14px;

    HorizontalLayout {
        spacing: 14px;

        Jazzicon {
            address: root.account.address;
            size: 44px;
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: root.account.name;
                color: Theme.palette-foreground;
                font-family: Theme.font-primary;
                font-size: Theme.font-size-body;
                font-weight: Theme.font-weight-medium;
                overflow: elide;
            }

            ShortAddressText {
                address: root.account.address;
            }
        }

        Text {
            text: "#" + root.account.single.account-number;
            vertical-alignment: center;
            color: Theme.palette-muted;
            font-family: Mono.family;
            font-size: 14px;
        }

        Image {
            width: 22px;
            source: Images.icon("chevron-right", 22px);
            colorize: Theme.palette-muted;
        }
    }
}

// The Default / Passphrase switch, shown while a passphrase is applied.
component WalletSwitch inherits SegmentedControl {
    options: [TR2.lookup(TrId.PassphraseDefault), TR2.lookup(TrId.PassphrasePassphrase)];
    selected-index: EnterPassphrase.slider-index;
    vertical-stretch: 0;
    changed(index, _label) => {
        EnterPassphrase.slider-index = index;
        EnterPassphrase.switch-view(index);
    }
}

component AccountList inherits Menu {
    full-width: true;

    for acct[index] in Callbacks.accounts: AccountRow {
        account: acct;
        divider: index < Callbacks.accounts.length - 1;
        clicked => {
            Navigate.account({ account-id: acct.id }, { });
        }
    }
}

component AccountsPage inherits Rectangle {
    property <bool> menu-open: false;
    property <bool> passphrase-modal-open: false;
    property <bool> has-passphrase: EnterPassphrase.passphrase != "";
    property <bool> passphrase-view: root.has-passphrase && EnterPassphrase.slider-index == 1;

    Page {
        spacing: Theme.spacing-md;

        // Which app, and which wallet it signs for.
        HorizontalLayout {
            spacing: Theme.spacing-md;
            vertical-stretch: 0;

            EthGlyph { }

            Text {
                text: TR2.lookup(TrId.HomeTitle);
                horizontal-stretch: 1;
                vertical-alignment: center;
                color: Theme.palette-foreground;
                font-family: Theme.font-primary;
                font-size: 30px;
                font-weight: Theme.font-weight-medium;
            }

            IconButton {
                variant: IconButtonVariant.ghost;
                max-width: self.preferred-width;
                icon: Images.icon("ellipsis", Theme.icon-size-md);
                clicked => {
                    root.menu-open = true;
                }
            }
        }

        HorizontalLayout {
            alignment: start;
            spacing: Theme.spacing-sm;
            vertical-stretch: 0;

            Chip {
                text: root.passphrase-view ? TR2.lookup(TrId.PassphrasePassphrase)
                    : Settings.seed-source == SeedSourceKind.UserMnemonic ? TR2.lookup(TrId.SeedSourceMnemonicTitle)
                    : TR2.lookup(TrId.SeedSourceAppTitle);
                variant: ChipVariant.soft;
                color: ChipColor.primary;
                size: ChipSize.sm;
            }

            if Callbacks.fingerprint != "": Chip {
                text: Callbacks.fingerprint;
                variant: ChipVariant.outlined;
                size: ChipSize.sm;
                font-family: Mono.family;
            }
        }

        if root.has-passphrase: WalletSwitch { }

        Rectangle {
            height: Theme.spacing-sm;
        }

        Eyebrow {
            text: TR2.lookup(TrId.HomeAccounts);
            vertical-stretch: 0;
        }

        if Callbacks.accounts.length > 0: ScrollArea {
            spacing: Theme.spacing-md;

            AccountList { }

            Button {
                text: TR2.lookup(TrId.HomeNewAccount);
                variant: ButtonVariant.ghost;
                start-icon: Images.icon("plus", Theme.icon-size-md);
                full-width: true;
                clicked => {
                    Navigate.create-account({ });
                }
            }
        }

        if Callbacks.accounts.length == 0: VerticalLayout {
            spacing: Theme.spacing-lg;
            vertical-stretch: 1;
            alignment: start;

            MutedText {
                text: TR2.lookup(TrId.HomeEmpty);
            }

            Button {
                text: TR2.lookup(TrId.HomeNewAccount);
                variant: ButtonVariant.secondary;
                start-icon: Images.icon("plus", Theme.icon-size-md);
                full-width: true;
                // Nothing to create an account under until the keys exist.
                disabled: Callbacks.fingerprint == "";
                clicked => {
                    Navigate.create-account({ });
                }
            }
        }

        Button {
            text: TR2.lookup(TrId.HomeScanToSign);
            size: ControlSize.lg;
            start-icon: Images.image("scan-qr");
            full-width: true;
            disabled: !Callbacks.can-scan;
            clicked => {
                if (Callbacks.can-scan) {
                    Callbacks.scan-clicked();
                }
            }
        }
    }

    if root.menu-open: Sheet {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        detents: [0.52];
        selected-detent: 0;
        dismissed => {
            root.menu-open = false;
        }

        Menu {
            full-width: true;

            MenuItem {
                label: TR2.lookup(TrId.AccountsMenuCreateAccount);
                start-icon: Images.icon("plus", Theme.icon-size-md);
                clicked => {
                    root.menu-open = false;
                    Navigate.create-account({ });
                }
            }

            MenuItem {
                label: root.has-passphrase ? TR2.lookup(TrId.AccountsMenuClearPassphrase) : TR2.lookup(TrId.AccountsMenuApplyPassphrase);
                start-icon: Images.icon(root.has-passphrase ? "unlock" : "lock", Theme.icon-size-md);
                // Passphrases only apply to an imported recovery phrase, not
                // the device app seed.
                disabled: !Settings.passphrase-available;
                clicked => {
                    if (Settings.passphrase-available) {
                        root.menu-open = false;
                        if (!Settings.show-passphrase-warning || root.has-passphrase) {
                            Navigate.enter-passphrase({ });
                        } else {
                            root.passphrase-modal-open = true;
                        }
                    }
                }
            }

            MenuItem {
                label: TR2.lookup(TrId.AccountsMenuViewArchive);
                start-icon: Images.image("archive");
                clicked => {
                    root.menu-open = false;
                    Callbacks.set-archive-mode(true);
                }
            }

            MenuItem {
                label: TR2.lookup(TrId.AccountsMenuSettings);
                start-icon: Images.icon("settings", Theme.icon-size-md);
                divider: false;
                clicked => {
                    root.menu-open = false;
                    Navigate.settings({ });
                }
            }
        }
    }

    if root.passphrase-modal-open: Dialog {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        dismissed => {
            root.passphrase-modal-open = false;
        }

        Text {
            text: TR2.lookup(TrId.PassphraseModalHeader);
            color: Theme.palette-foreground;
            font-family: Theme.font-primary;
            font-size: Theme.font-size-title;
            font-weight: Theme.font-weight-medium;
            wrap: word-wrap;
        }

        MutedText {
            text: TR2.lookup(TrId.PassphraseModalContent);
        }

        Checkbox {
            label: TR2.lookup(TrId.CommonButtonDontShowAgain);
            checked: !Settings.show-passphrase-warning;
            changed(checked) => {
                Settings.set-show-passphrase-warning(!checked);
            }
        }

        Button {
            text: TR2.lookup(TrId.CommonButtonConfirm);
            full-width: true;
            clicked => {
                root.passphrase-modal-open = false;
                Navigate.enter-passphrase({ });
            }
        }
    }
}

component ArchivePage inherits Page {
    property <bool> has-passphrase: EnterPassphrase.passphrase != "";

    PageHeader {
        title: TR2.lookup(TrId.AccountArchiveTitle);
        action-clicked => {
            Callbacks.set-archive-mode(false);
        }
    }

    if root.has-passphrase: WalletSwitch { }

    if Callbacks.accounts.length > 0: ScrollArea {
        AccountList { }
    }

    if Callbacks.accounts.length == 0: VerticalLayout {
        vertical-stretch: 1;
        alignment: center;

        MutedText {
            text: TR2.lookup(TrId.AccountArchiveNoArchivedAccounts);
            horizontal-alignment: center;
        }
    }
}

export component HomePage inherits Rectangle {
    if !Callbacks.archive-mode: AccountsPage {
        width: parent.width;
        height: parent.height;
    }

    if Callbacks.archive-mode: ArchivePage {
        width: parent.width;
        height: parent.height;
    }
}
