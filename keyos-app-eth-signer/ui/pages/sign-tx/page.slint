// Ethereum signing review. All three request kinds -- transaction, EIP-712
// typed data and EIP-191 message -- share one ui2 surface: a tab bar, a
// fixed-height panel, and Back/Next buttons that page the panel a screenful
// at a time. See review.slint for why the payload is paged rather than
// flicked.
//
// The page's geometry is fixed by construction. Every part has a constant
// height and the panel absorbs whatever the warning row takes, so the sign
// control cannot be pushed off the bottom of the screen by a longer payload.

import { NavHeader, BasePage, TextSm, TextMd, Button, PageBody, ContentSection, ButtonSection, JumboIconPageBody, TimerCircularProgress, HeadingMd, WrappedIcon, QrCodeCard, Icon } from "../../compat/widgets.slint";
import { Palette, Size, Importance } from "../../compat/theme.slint";
import { TR2, TrId } from "../../gen/tr.slint";

import { SignTxProps } from "./props.slint";
import { SignTx, SignTxState, SignRequestKind, EthTxView, EthTypedDataView, EthMessageView } from "../../sign-tx.slint";

import { SignReview } from "review.slint";
import { Button as Ui2Button } from "@ui/button.slint";
import { SlideToConfirm } from "@ui/slide_to_confirm.slint";
import { Theme, ControlSize, ButtonVariant } from "@ui/theme.slint";

component WarningRow inherits HorizontalLayout {
    in property <string> text;

    alignment: center;
    spacing: Size.sz2;

    VerticalLayout {
        alignment: center;
        Icon {
            name: "alert";
            color: Palette.content-notice;
            size: Size.sz5;
        }
    }

    TextSm {
        text: root.text;
        color: Palette.content-notice;
        vertical-alignment: center;
        wrap: word-wrap;
        width: 380px;
    }
}

component SignPage inherits VerticalLayout {
    property <bool> signing: SignTx.state == SignTxState.Signing;
    property <SignRequestKind> kind: SignTx.kind;
    property <bool> typed: kind == SignRequestKind.TypedData;
    property <bool> message: kind == SignRequestKind.Message;
    property <bool> transaction: kind == SignRequestKind.Transaction;
    property <EthTxView> tx: SignTx.pending-tx;
    property <EthTypedDataView> td: SignTx.pending-typed-data;
    property <EthMessageView> msg: SignTx.pending-message;

    // A warning takes its band out of the panel instead of pushing everything
    // below it down and off the screen.
    property <bool> warn: (transaction && tx.has-data) || (message && !msg.displayable);

    NavHeader {
        title: typed ? TR2.lookup(TrId.SignTxTypedDataTitle)
            : message ? TR2.lookup(TrId.SignMessageTitle)
            : TR2.lookup(TrId.SigningTransactionTitle);
        left-icon: "chevron-left";

        clicked => {
            SignTx.done();
        }
    }

    VerticalLayout {
        alignment: space-between;
        padding-left: Size.sz4;
        padding-right: Size.sz4;
        padding-bottom: Size.sz4;

        VerticalLayout {
            alignment: start;
            spacing: Size.sz2;

            Text {
                text: typed ? TR2.lookup(TrId.SignTxTypedDataSubheader)
                    : message ? TR2.lookup(TrId.SignTxMessageSubheader)
                    : TR2.lookup(TrId.SigningTransactionSubheader);
                color: Theme.palette-muted;
                horizontal-alignment: center;
                wrap: word-wrap;
                font-family: Theme.font-primary;
                font-size: Theme.font-size-subtitle;
            }

            if warn: WarningRow {
                text: transaction ? TR2.lookup(TrId.SignTxDataWarning)
                    : TR2.lookup(TrId.SignTxMessageWarning);
            }

            review := SignReview {
                avail-height: warn ? 428px : 504px;

                // The transaction lists its fields; the other two wrap text.
                fields-mode: transaction;
                tx: tx;
                body: typed ? td.json : msg.text;

                // Captions are kept short: four tabs share 448px.
                tab-labels: transaction
                    ? (tx.has-data
                        ? [TR2.lookup(TrId.SignTxTabDetails), TR2.lookup(TrId.SignTxTabData)]
                        : [TR2.lookup(TrId.SignTxTabDetails)])
                    : typed
                        ? [TR2.lookup(TrId.SignTxMessageTitle), TR2.lookup(TrId.SignTxTabEip712),
                           TR2.lookup(TrId.SignTxTabDomain), TR2.lookup(TrId.SignTxTabHash)]
                        : [TR2.lookup(TrId.SignTxMessageTitle), TR2.lookup(TrId.SignTxTabDigest)];

                // Index 0 is the payload tab and carries no hash.
                hash-values: transaction
                    ? ["", tx.data-digest]
                    : typed
                        ? ["", td.eip712-digest, td.domain-hash, td.message-hash]
                        : ["", msg.eip191-digest];
            }
        }

        if !signing: VerticalLayout {
            alignment: end;
            spacing: Size.sz2;

            Ui2Button {
                text: TR2.lookup(TrId.CommonButtonCancel);
                variant: ButtonVariant.tertiary;
                size: ControlSize.md;
                full-width: true;

                clicked => {
                    SignTx.done();
                }
            }

            // Signing stays locked until the payload has been paged to its
            // end, so nothing can be approved unseen.
            SlideToConfirm {
                label: TR2.lookup(TrId.CommonSlideToSignSign);
                hint: TR2.lookup(TrId.CommonSlideToSignHelper);
                size: ControlSize.md;
                disabled: !review.read-to-end;

                activated => {
                    SignTx.sign-tx();
                }
            }
        }

        if signing: Ui2Button {
            text: TR2.lookup(TrId.CommonSlideToSignSigning);
            variant: ButtonVariant.tertiary;
            size: ControlSize.md;
            loading: true;
            disabled: true;
            full-width: true;
        }
    }
}

component VerifyingPage inherits JumboIconPageBody {
    ContentSection {
        HorizontalLayout {
            alignment: center;
            TimerCircularProgress {
                indeterminate: true;
            }
        }

        HeadingMd {
            text: TR2.lookup(TrId.ValidatingTransactionTitle);
            horizontal-alignment: center;
        }
    }
}

component SuccessPage inherits VerticalLayout {
    NavHeader {
        title: TR2.lookup(TrId.SigningTransactionSuccessQRTitle);
        left-icon: "chevron-left";

        clicked => {
            SignTx.done();
        }
    }

    PageBody {
        ContentSection {
            TextMd {
                text: TR2.lookup(TrId.SigningTransactionSuccessQRSubheader);
                color: Palette.content-tertiary;
                horizontal-alignment: center;
            }

            HorizontalLayout {
                alignment: center;

                QrCodeCard {
                    data: SignTx.signature-ur;
                }
            }
        }

        ButtonSection {
            Button {
                importance: primary;
                icon: "";
                label: TR2.lookup(TrId.CommonButtonDone);
                clicked => {
                    SignTx.done();
                }
            }
        }
    }
}

component ErrorPage inherits JumboIconPageBody {
    ContentSection {
        HorizontalLayout {
            alignment: center;
            WrappedIcon {
                inner-icon: "close";
            }
        }

        VerticalLayout {
            spacing: Size.sz5;

            HeadingMd {
                text: TR2.lookup(TrId.InvalidQrHeader);
                horizontal-alignment: center;
            }

            TextMd {
                text: SignTx.error-message;
                horizontal-alignment: center;
                color: Palette.content-secondary;
                wrap: word-wrap;
            }
        }
    }

    ButtonSection {
        Button {
            importance: Importance.primary;
            label: TR2.lookup(TrId.CommonButtonDone);
            clicked => {
                SignTx.done();
            }
        }
    }
}

export component SignTxPage inherits BasePage {
    in property <SignTxProps> props;

    property <SignTxState> state: SignTx.state;

    if state == SignTxState.Verifying: VerifyingPage { }
    if state == SignTxState.Sign || state == SignTxState.Signing: SignPage { }
    if state == SignTxState.Success: SuccessPage { }
    if state == SignTxState.Error || state == SignTxState.Idle: ErrorPage { }
}
