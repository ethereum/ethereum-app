// A new account: a label, and under the advanced options the BIP-44 account
// index, defaulting to the first free one.

import { Theme, Images, ButtonVariant } from "@ui/theme.slint";
import { Button } from "@ui/button.slint";
import { Input } from "@ui/input.slint";
import { CreateAccountProps } from "./props.slint";
import { CreateAccount, CreateAccountState } from "../../create-account.slint";
import { Navigate } from "../../gen/navigate.slint";
import { TR2, TrId } from "../../gen/tr.slint";
import { Page, PageHeader, ScrollArea } from "../../components/layout.slint";
import { Mono, MutedText } from "../../components/eth-widgets.slint";
import { StatusView, StatusKind } from "../../components/status.slint";

component Disclosure inherits Rectangle {
    in property <string> text;
    in-out property <bool> open;

    height: 48px;

    HorizontalLayout {
        spacing: Theme.spacing-sm;

        Text {
            text: root.text;
            horizontal-stretch: 1;
            vertical-alignment: center;
            color: Theme.palette-foreground;
            font-family: Theme.font-primary;
            font-size: Theme.font-size-subtitle;
            font-weight: Theme.font-weight-medium;
        }

        Image {
            width: 22px;
            source: Images.icon(root.open ? "chevron-up" : "chevron-down", 22px);
            colorize: Theme.palette-muted;
        }
    }

    TouchArea {
        clicked => {
            root.open = !root.open;
        }
    }
}

export component CreateAccountPage inherits Rectangle {
    in property <CreateAccountProps> props;

    property <string> new-label;
    property <string> label-error;
    property <bool> label-touched: false;
    property <bool> advanced-open: false;
    // Strings stand for u32 indices: Slint ints are i32.
    property <string> next-available-index: CreateAccount.get-next-index();
    property <string> new-index: CreateAccount.get-next-index();
    property <string> index-message: CreateAccount.validate-new-index(root.new-index);
    property <bool> has-errors: !root.label-touched || root.label-error != "" || root.index-message != "" || root.new-index == "";

    // The CreateAccount global outlives this page; a stale Success or Error
    // from a previous visit would otherwise block the form.
    init => {
        CreateAccount.state = CreateAccountState.Idle;
    }

    if CreateAccount.state == CreateAccountState.Idle: form := Page {
        PageHeader {
            title: TR2.lookup(TrId.CreateAccountTitle);
            action-clicked => {
                Navigate.backward();
            }
        }

        ScrollArea {
            Input {
                label: TR2.lookup(TrId.CreateAccountLabel);
                placeholder: TR2.lookup(TrId.CreateAccountLabelFillerText);
                value <=> root.new-label;
                error: root.label-error;
                changed(text) => {
                    root.label-touched = true;
                    root.label-error = CreateAccount.validate-new-label(text);
                }
                submitted(_text) => {
                    form.dismiss-keyboard();
                }
            }

            Disclosure {
                text: TR2.lookup(TrId.CreateAccountAdvancedOptions);
                open <=> root.advanced-open;
            }

            if root.advanced-open: Input {
                label: TR2.lookup(TrId.CreateAccountIndex);
                value: root.new-index;
                input-type: InputType.number;
                error: root.index-message;
                changed(text) => {
                    root.new-index = text;
                }
                submitted(text) => {
                    if (text == "") {
                        root.new-index = root.next-available-index;
                    }
                    form.dismiss-keyboard();
                }
            }

            if root.advanced-open: MutedText {
                text: "m/44'/60'/" + (root.new-index == "" ? "…" : root.new-index) + "'";
                font-family: Mono.family;
            }
        }

        Button {
            text: TR2.lookup(TrId.CommonButtonCreate);
            full-width: true;
            disabled: root.has-errors;
            clicked => {
                CreateAccount.create-single-sig({
                    label: root.new-label,
                    index: root.new-index,
                });
            }
        }
    }

    if CreateAccount.state == CreateAccountState.Creating: StatusView {
        kind: StatusKind.working;
        heading: TR2.lookup(TrId.CreatingAccountHeader);

        Rectangle { vertical-stretch: 1; }
    }

    if CreateAccount.state == CreateAccountState.Success: StatusView {
        kind: StatusKind.success;
        heading: TR2.lookup(TrId.CreatingAccountSuccessHeader);

        Rectangle { vertical-stretch: 1; }

        Button {
            text: TR2.lookup(TrId.CommonButtonDone);
            full-width: true;
            clicked => {
                CreateAccount.state = CreateAccountState.Idle;
                Navigate.backward();
            }
        }
    }

    if CreateAccount.state == CreateAccountState.Error: StatusView {
        kind: StatusKind.failure;
        heading: TR2.lookup(TrId.CreatingAccountFailedHeader);
        message: TR2.lookup(TrId.CreatingAccountFailedSubheader);

        Rectangle { vertical-stretch: 1; }

        Button {
            text: TR2.lookup(TrId.CommonButtonRetry);
            full-width: true;
            clicked => {
                CreateAccount.state = CreateAccountState.Idle;
            }
        }
    }
}
