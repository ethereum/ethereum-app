// Where the keys come from. Each option is a different wallet, so each card
// says what picking it means; on first launch this is the welcome screen.

import { Theme, ButtonVariant } from "@ui/theme.slint";
import { Button } from "@ui/button.slint";
import { Card } from "@ui/card.slint";
import { Dialog, DialogVariant } from "@ui/dialog.slint";
import { TR2, TrId } from "../../gen/tr.slint";
import { SeedSourceProps } from "props.slint";
import { Settings, SeedSourceKind } from "../../settings.slint";
import { Navigate } from "../../gen/navigate.slint";
import { Page, PageHeader, HeaderAction, ScrollArea } from "../../components/layout.slint";
import { MutedText, EthGlyph } from "../../components/eth-widgets.slint";

export component SeedSourcePage inherits Rectangle {
    in property <SeedSourceProps> props;

    // The first-launch pass is exactly "nothing chosen yet": there is no
    // wallet to go back to, nothing to delete, and no confirmation to ask for.
    property <bool> first-run: Settings.seed-source == SeedSourceKind.Unset;

    // The page owns the selection until it is committed, so the cards respond
    // immediately while the wallet behind Settings.seed-source is untouched.
    property <SeedSourceKind> picked: Settings.seed-source;
    property <bool> changed: root.picked != Settings.seed-source;
    property <bool> confirm-open: false;
    // Leaving an imported phrase means leaving the only copy this device holds.
    property <bool> leaving-mnemonic: Settings.seed-source == SeedSourceKind.UserMnemonic;

    Page {
        if root.first-run: HorizontalLayout {
            spacing: Theme.spacing-md;
            vertical-stretch: 0;
            padding-top: Theme.spacing-sm;

            EthGlyph { }

            Text {
                text: TR2.lookup(TrId.SeedSourceTitle);
                vertical-alignment: center;
                color: Theme.palette-foreground;
                font-family: Theme.font-primary;
                font-size: 30px;
                font-weight: Theme.font-weight-medium;
            }
        }

        if !root.first-run: PageHeader {
            title: TR2.lookup(TrId.SeedSourceTitle);
            action-clicked => {
                Navigate.backward();
            }
        }

        ScrollArea {
            MutedText {
                text: TR2.lookup(TrId.SeedSourceIntro);
            }

            Card {
                title: TR2.lookup(TrId.SeedSourceAppTitle);
                body: TR2.lookup(TrId.SeedSourceAppBody);
                interactive: true;
                selected: root.picked == SeedSourceKind.AppSeed;
                clicked => {
                    root.picked = SeedSourceKind.AppSeed;
                }
            }

            Card {
                title: TR2.lookup(TrId.SeedSourceMnemonicTitle);
                body: TR2.lookup(TrId.SeedSourceMnemonicBody);
                interactive: true;
                selected: root.picked == SeedSourceKind.UserMnemonic;
                clicked => {
                    root.picked = SeedSourceKind.UserMnemonic;
                }
            }
        }

        Button {
            text: TR2.lookup(TrId.CommonButtonContinue);
            full-width: true;
            // On first launch any choice is a commit; afterwards only a
            // different one is.
            disabled: root.picked == SeedSourceKind.Unset || !(root.first-run || root.changed);
            clicked => {
                if (root.first-run) {
                    // No accounts exist yet, so there is nothing to warn about.
                    Settings.choose-seed-source(root.picked);
                } else {
                    root.confirm-open = true;
                }
            }
        }
    }

    if root.confirm-open: Dialog {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        variant: DialogVariant.danger;
        dismissed => {
            root.confirm-open = false;
        }

        Text {
            text: TR2.lookup(TrId.SeedSourceModalHeader);
            color: Theme.palette-foreground;
            font-family: Theme.font-primary;
            font-size: Theme.font-size-title;
            font-weight: Theme.font-weight-medium;
            wrap: word-wrap;
        }

        // Leaving an imported phrase adds the verify-your-backup warning.
        MutedText {
            text: root.leaving-mnemonic ? TR2.lookup(TrId.SeedSourceModalBackupWarning) : TR2.lookup(TrId.SeedSourceModalContent);
        }

        HorizontalLayout {
            spacing: Theme.spacing-sm;

            Button {
                text: TR2.lookup(TrId.CommonButtonCancel);
                variant: ButtonVariant.secondary;
                full-width: true;
                clicked => {
                    root.confirm-open = false;
                }
            }

            Button {
                text: TR2.lookup(TrId.CommonButtonConfirm);
                variant: ButtonVariant.danger;
                full-width: true;
                clicked => {
                    root.confirm-open = false;
                    Settings.choose-seed-source(root.picked);
                }
            }
        }
    }
}
