// The outcome of checking a scanned address against the account.

import { Theme, ButtonVariant } from "@ui/theme.slint";
import { Button } from "@ui/button.slint";
import { TR2, TrId } from "../../../gen/tr.slint";
import { Navigate, Animate } from "../../../gen/navigate.slint";
import { AccountProps } from "../../account/props.slint";
import { VerifyAddressProps } from "./props.slint";
import { VerifyAddress, VerifyAddressState } from "../../../verify-address.slint";
import { StatusView, StatusKind } from "../../../components/status.slint";
import { Panel, AddressBlock, DetailRow } from "../../../components/eth-widgets.slint";

export component VerifyAddressPage inherits Rectangle {
    in property <AccountProps> acct-props;
    in property <VerifyAddressProps> props;

    if VerifyAddress.state == VerifyAddressState.Loading: StatusView {
        kind: StatusKind.working;
        heading: TR2.lookup(TrId.VerifyAddressLoadingTitle);
        message: TR2.lookup(TrId.VerifyAddressLoadingContent);

        Rectangle { vertical-stretch: 1; }

        Button {
            text: TR2.lookup(TrId.CommonButtonCancel);
            variant: ButtonVariant.secondary;
            full-width: true;
            clicked => {
                Navigate.backward-animate(Animate.None);
            }
        }
    }

    if VerifyAddress.state == VerifyAddressState.Success: StatusView {
        kind: StatusKind.success;
        heading: TR2.lookup(TrId.VerifyAddressSuccessTitle);

        Panel {
            AddressBlock {
                address: VerifyAddress.address;
            }

            DetailRow {
                label: TR2.lookup(TrId.VerifyAddressSuccessReceiveAddress);
                value: TR2.format(TrId.VerifyAddressSuccessAddressIndex, [VerifyAddress.index]);
            }
        }

        Rectangle { vertical-stretch: 1; }

        Button {
            text: TR2.lookup(TrId.CommonButtonDone);
            full-width: true;
            clicked => {
                Navigate.return-home();
            }
        }
    }

    if VerifyAddress.state == VerifyAddressState.Error: StatusView {
        kind: StatusKind.failure;
        heading: TR2.lookup(TrId.VerifyAddressFailedTitle);
        message: TR2.lookup(TrId.VerifyAddressFailedContent);

        Panel {
            DetailRow {
                label: TR2.lookup(TrId.VerifyAddressFailedRangesChecked);
                value: VerifyAddress.checked-ranges.receive-start + " – " + VerifyAddress.checked-ranges.receive-end;
            }
        }

        Rectangle { vertical-stretch: 1; }

        Button {
            text: TR2.lookup(TrId.VerifyAddressFailedContinueSearching);
            full-width: true;
            clicked => {
                VerifyAddress.continue-verify-address({
                    account-id: root.acct-props.account-id,
                    show-skip-button: false,
                    show-view-all: true,
                },
                VerifyAddress.address,
                VerifyAddress.attempt-number + 1);
            }
        }

        Button {
            text: TR2.lookup(TrId.CommonButtonSkipVerification);
            variant: ButtonVariant.secondary;
            full-width: true;
            clicked => {
                Navigate.return-home();
            }
        }
    }

    if VerifyAddress.state == VerifyAddressState.Invalid: StatusView {
        kind: StatusKind.failure;
        heading: TR2.lookup(TrId.InvalidAddressTitle);
        message: TR2.lookup(TrId.InvalidAddressContent);

        Rectangle { vertical-stretch: 1; }

        Button {
            text: TR2.lookup(TrId.CommonButtonRetry);
            full-width: true;
            clicked => {
                Navigate.backward-animate(Animate.None);
            }
        }
    }

    if VerifyAddress.state == VerifyAddressState.Skipped: StatusView {
        kind: StatusKind.caution;
        heading: TR2.lookup(TrId.VerifyAddressSkipVerificationTitle);
        message: TR2.lookup(TrId.VerifyAddressSkipVerificationContent);

        Rectangle { vertical-stretch: 1; }

        Button {
            text: TR2.lookup(TrId.CommonButtonBack);
            full-width: true;
            clicked => {
                Navigate.backward();
            }
        }

        Button {
            text: TR2.lookup(TrId.CommonButtonSkipVerification);
            variant: ButtonVariant.secondary;
            full-width: true;
            clicked => {
                Navigate.return-home();
            }
        }
    }
}
