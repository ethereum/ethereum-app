// One account: its first address with the Jazzicon a wallet will show, what
// can be done with it, its label and key details, and archiving.

import { Theme, Images, ButtonVariant, ControlSize } from "@ui/theme.slint";
import { Button } from "@ui/button.slint";
import { Input } from "@ui/input.slint";
import { Menu } from "@ui/menu.slint";
import { MenuItem } from "@ui/menu_item.slint";
import { Dialog, DialogVariant } from "@ui/dialog.slint";
import { TR2, TrId } from "../../gen/tr.slint";
import { Navigate } from "../../gen/navigate.slint";
import { AccountProps } from "./props.slint";
import { Callbacks, AccountView } from "../../callbacks.slint";
import { CreateAccount } from "../../create-account.slint";
import { VerifyAddress } from "../../verify-address.slint";
import { Page, PageHeader, ScrollArea } from "../../components/layout.slint";
import { Mono, Eyebrow, MutedText, Panel, PanelDivider, DetailRow, Jazzicon, HexBlock } from "../../components/eth-widgets.slint";

component ConfirmDialog inherits Dialog {
    in property <string> heading;
    in property <string> message;
    in property <string> confirm-label: TR2.lookup(TrId.CommonButtonConfirm);
    callback confirmed();

    x: 0;
    y: 0;

    Text {
        text: root.heading;
        color: Theme.palette-foreground;
        font-family: Theme.font-primary;
        font-size: Theme.font-size-title;
        font-weight: Theme.font-weight-medium;
        wrap: word-wrap;
    }

    MutedText {
        text: root.message;
    }

    HorizontalLayout {
        spacing: Theme.spacing-sm;

        Button {
            text: TR2.lookup(TrId.CommonButtonCancel);
            variant: ButtonVariant.secondary;
            full-width: true;
            clicked => {
                root.dismissed();
            }
        }

        Button {
            text: root.confirm-label;
            variant: root.variant == DialogVariant.danger ? ButtonVariant.danger : ButtonVariant.primary;
            full-width: true;
            clicked => {
                root.confirmed();
            }
        }
    }
}

export component AccountPage inherits Rectangle {
    in property <AccountProps> props;

    property <AccountView> account: Callbacks.account-details(props.account-id);
    property <bool> archive-open: false;
    property <bool> delete-open: false;
    property <string> label-error;

    page := Page {
        PageHeader {
            title: root.account.name;
            subtitle: "m/44'/60'/" + root.account.single.account-number + "'";
            action-clicked => {
                Navigate.backward();
            }
        }

        ScrollArea {
            // The account's face: the icon and address a wallet will show.
            Panel {
                HorizontalLayout {
                    alignment: center;

                    Jazzicon {
                        address: root.account.address;
                        size: 72px;
                    }
                }

                HexBlock {
                    value: root.account.address;
                    groups-per-line: 5;
                    size: 22px;
                    center: true;
                }

                Eyebrow {
                    text: TR2.lookup(TrId.AccountAddress);
                    horizontal-alignment: center;
                }
            }

            if !root.account.archived: Menu {
                full-width: true;

                MenuItem {
                    label: TR2.lookup(TrId.AccountsConnectWallet);
                    start-icon: Images.icon("share", Theme.icon-size-md);
                    end-icon: Images.icon("chevron-right", Theme.icon-size-md);
                    clicked => {
                        Navigate.account-connect({ account-id: root.account.id }, { });
                    }
                }

                MenuItem {
                    label: TR2.lookup(TrId.AccountsVerifyAddress);
                    start-icon: Images.icon("check", Theme.icon-size-md);
                    end-icon: Images.icon("chevron-right", Theme.icon-size-md);
                    clicked => {
                        VerifyAddress.verify-address({ account-id: root.account.id, show-view-all: true });
                    }
                }

                MenuItem {
                    label: TR2.lookup(TrId.ExploreAddressesTitle);
                    start-icon: Images.icon("search", Theme.icon-size-md);
                    end-icon: Images.icon("chevron-right", Theme.icon-size-md);
                    divider: false;
                    clicked => {
                        Navigate.explore-address({ account-id: root.account.id }, { });
                    }
                }
            }

            Eyebrow {
                text: TR2.lookup(TrId.AccountDetails);
            }

            Input {
                label: TR2.lookup(TrId.DetailsSinglesigLabel);
                value: root.account.name;
                disabled: root.account.archived;
                error: root.label-error;
                changed(text) => {
                    root.label-error = text != root.account.name ? CreateAccount.validate-new-label(text) : "";
                }
                submitted(text) => {
                    if (root.label-error == "" && text != root.account.name) {
                        Callbacks.update-account-name(root.account.id, text);
                    }
                    page.dismiss-keyboard();
                }
            }

            Panel {
                spacing: Theme.spacing-md;

                DetailRow {
                    label: TR2.lookup(TrId.DetailsSinglesigAccountNumber);
                    value: root.account.single.account-number;
                }

                PanelDivider { }

                DetailRow {
                    label: TR2.lookup(TrId.DetailsSinglesigFingerprint);
                    value: root.account.single.fingerprint;
                }
            }

            if !root.account.archived: Button {
                text: TR2.lookup(TrId.DetailsSinglesigMenuArchiveAccount);
                variant: ButtonVariant.secondary;
                start-icon: Images.image("archive");
                full-width: true;
                clicked => {
                    root.archive-open = true;
                }
            }

            if root.account.archived: Button {
                text: TR2.lookup(TrId.ArchivedAccountRestoreAccount);
                full-width: true;
                clicked => {
                    Callbacks.update-account-archived(root.account.id, false);
                    Navigate.backward();
                }
            }

            if root.account.archived: Button {
                text: TR2.lookup(TrId.ArchivedAccountDeleteAccount);
                variant: ButtonVariant.danger;
                start-icon: Images.icon("trash-2", Theme.icon-size-md);
                full-width: true;
                clicked => {
                    root.delete-open = true;
                }
            }
        }
    }

    if root.archive-open: ConfirmDialog {
        width: root.width;
        height: root.height;
        heading: TR2.lookup(TrId.ArchiveAccountModalHeader);
        message: TR2.lookup(TrId.ArchiveAccountModalContent);
        dismissed => {
            root.archive-open = false;
        }
        confirmed => {
            Callbacks.update-account-archived(root.account.id, true);
            root.archive-open = false;
            Navigate.backward();
        }
    }

    if root.delete-open: ConfirmDialog {
        width: root.width;
        height: root.height;
        variant: DialogVariant.danger;
        heading: TR2.lookup(TrId.DeleteAccountModalHeader);
        message: TR2.format(TrId.DeleteAccountModalSubheader, [root.account.name]);
        confirm-label: TR2.lookup(TrId.CommonButtonDelete);
        dismissed => {
            root.delete-open = false;
        }
        confirmed => {
            Callbacks.delete-account(root.account.id);
            root.delete-open = false;
            Navigate.backward();
        }
    }
}
