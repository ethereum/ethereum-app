// Every address of the account, derived lazily as the list scrolls; a tap
// opens one in full with its QR, and steps to its neighbours with buttons
// rather than a gesture.

import { Theme, Images, ButtonVariant, ControlSize } from "@ui/theme.slint";
import { Button } from "@ui/button.slint";
import { ListView } from "std-widgets.slint";
import { TR2, TrId } from "../../../gen/tr.slint";
import { Navigate } from "../../../gen/navigate.slint";
import { AccountProps } from "../props.slint";
import { Callbacks } from "../../../callbacks.slint";
import { Page, PageHeader, HeaderAction, PageMetrics } from "../../../components/layout.slint";
import { Mono, MutedText, Jazzicon, ShortAddressText, HexBlock, QrPanel } from "../../../components/eth-widgets.slint";

component AddressDetail inherits Page {
    in property <[string]> addresses;
    in-out property <int> selected;
    callback closed();

    property <string> address: root.addresses[root.selected];

    PageHeader {
        title: TR2.format(TrId.ExploreAddressesDetailTitle, [root.selected]);
        action: HeaderAction.close;
        action-clicked => {
            root.closed();
        }
    }

    HorizontalLayout {
        alignment: center;
        vertical-stretch: 0;

        Jazzicon {
            address: root.address;
            size: 56px;
        }
    }

    HexBlock {
        value: root.address;
        groups-per-line: 5;
        size: 22px;
        center: true;
        vertical-stretch: 0;
    }

    QrPanel {
        data: root.address;
        size: 320px;
    }

    MutedText {
        text: TR2.lookup(TrId.ExploreAddressesDetailContent);
        horizontal-alignment: center;
    }

    Rectangle { vertical-stretch: 1; }

    HorizontalLayout {
        spacing: Theme.spacing-sm;
        vertical-stretch: 0;

        Button {
            text: TR2.lookup(TrId.CommonButtonPrevious);
            variant: ButtonVariant.secondary;
            start-icon: Images.icon("chevron-left", Theme.icon-size-md);
            full-width: true;
            disabled: root.selected <= 0;
            clicked => {
                root.selected = max(0, root.selected - 1);
            }
        }

        Button {
            text: TR2.lookup(TrId.CommonButtonNext);
            variant: ButtonVariant.secondary;
            end-icon: Images.icon("chevron-right", Theme.icon-size-md);
            full-width: true;
            disabled: root.selected >= root.addresses.length - 1;
            clicked => {
                root.selected = min(root.addresses.length - 1, root.selected + 1);
            }
        }
    }
}

export component ExploreAddressPage inherits Rectangle {
    in-out property <AccountProps> props;

    property <[string]> addresses: Callbacks.account-addresses(root.props.account-id);
    property <int> selected: -1;
    property <length> row-height: 64px;

    Page {
        spacing: Theme.spacing-sm;

        PageHeader {
            title: TR2.lookup(TrId.ExploreAddressesTitle);
            action-clicked => {
                Navigate.backward();
            }
        }

        ListView {
            vertical-stretch: 1;
            vertical-scrollbar-policy: always-off;
            mouse-drag-pan-enabled: true;

            for address[index] in root.addresses: Rectangle {
                height: root.row-height;
                background: touch.pressed ? Theme.palette-foreground.with-alpha(0.05) : transparent;

                HorizontalLayout {
                    spacing: Theme.spacing-md;
                    padding-right: Theme.spacing-sm;

                    Text {
                        width: 44px;
                        text: index;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        color: Theme.palette-muted;
                        font-family: Mono.family;
                        font-size: 15px;
                    }

                    VerticalLayout {
                        alignment: center;

                        Jazzicon {
                            address: address;
                            size: 32px;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;

                        ShortAddressText {
                            address: address;
                            size: 19px;
                        }
                    }

                    Image {
                        width: 22px;
                        source: Images.icon("chevron-right", 22px);
                        colorize: Theme.palette-muted;
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.palette-border.with-alpha(0.5);
                }

                touch := TouchArea {
                    clicked => {
                        root.selected = index;
                    }
                }
            }
        }
    }

    if root.selected >= 0: AddressDetail {
        width: root.width;
        height: root.height;
        addresses: root.addresses;
        selected <=> root.selected;
        closed => {
            root.selected = -1;
        }
    }
}
