// Connect a watch-only wallet: the account's ERC-4527 crypto-hdkey as a QR,
// then the address check that proves the wallet derived the same addresses.

import { Theme, ButtonVariant } from "@ui/theme.slint";
import { Button } from "@ui/button.slint";
import { TR2, TrId } from "../../../gen/tr.slint";
import { Navigate } from "../../../gen/navigate.slint";
import { AccountProps } from "../props.slint";
import { AccountConnectProps } from "./props.slint";
import { ConnectAccount } from "../../../connect-account.slint";
import { VerifyAddress } from "../../../verify-address.slint";
import { Page, PageHeader } from "../../../components/layout.slint";
import { MutedText, QrPanel } from "../../../components/eth-widgets.slint";

export component AccountConnectPage inherits Page {
    in property <AccountProps> acct-props;
    in property <AccountConnectProps> props;

    PageHeader {
        title: TR2.lookup(TrId.AccountsConnectWallet);
        action-clicked => {
            Navigate.backward();
        }
    }

    MutedText {
        text: TR2.lookup(TrId.ConnectScanSubheader);
        horizontal-alignment: center;
    }

    Rectangle { vertical-stretch: 1; }

    QrPanel {
        data: ConnectAccount.export-account-qr(root.acct-props.account-id);
        size: 400px;
    }

    Rectangle { vertical-stretch: 1; }

    Button {
        text: TR2.lookup(TrId.CommonButtonVerifyAddress);
        full-width: true;
        clicked => {
            VerifyAddress.verify-address({
                account-id: root.acct-props.account-id,
                show-skip-button: true,
                show-view-all: false,
            });
        }
    }
}
