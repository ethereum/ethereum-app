import { Theme, Images } from "@ui/theme.slint";
import { Menu } from "@ui/menu.slint";
import { MenuItem } from "@ui/menu_item.slint";
import { TR2, TrId } from "../../gen/tr.slint";
import { SettingsProps } from "props.slint";
import { Settings, SeedSourceKind } from "../../settings.slint";
import { Navigate } from "../../gen/navigate.slint";
import { Page, PageHeader } from "../../components/layout.slint";
import { Eyebrow } from "../../components/eth-widgets.slint";

export component SettingsPage inherits Page {
    in property <SettingsProps> props;

    // The choice, and what it means, live on the seed-source page; this row is
    // only the way in and the current answer.
    property <string> current: Settings.seed-source == SeedSourceKind.AppSeed
        ? TR2.lookup(TrId.SeedSourceAppTitle)
        : Settings.seed-source == SeedSourceKind.UserMnemonic
            ? TR2.lookup(TrId.SeedSourceMnemonicTitle)
            : TR2.lookup(TrId.SettingsSeedSourceNotSet);

    PageHeader {
        title: TR2.lookup(TrId.SettingsTitle);
        action-clicked => {
            Navigate.backward();
        }
    }

    Eyebrow {
        text: TR2.lookup(TrId.SettingsSeedSourceEyebrow);
    }

    Menu {
        full-width: true;

        MenuItem {
            label: root.current;
            start-icon: Images.icon("lock", Theme.icon-size-md);
            end-icon: Images.icon("chevron-right", Theme.icon-size-md);
            divider: false;
            clicked => {
                Navigate.seed-source({ });
            }
        }
    }

    Rectangle { vertical-stretch: 1; }
}
