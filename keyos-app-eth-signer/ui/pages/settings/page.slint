import { TR2, TrId } from "../../gen/tr.slint";
import { Size } from "../../compat/theme.slint";
import { BasePage, PageBody, NavHeader, MenuSection, MenuSectionLayout, MenuActionItem } from "../../compat/widgets.slint";

import { SettingsProps } from "props.slint";
import { Settings, SeedSourceKind } from "../../settings.slint";
import { Navigate } from "../../gen/navigate.slint";

export component SettingsPage inherits BasePage {
    in property <SettingsProps> props;

    // The choice, and the explanation of what it means, both live on the
    // seed-source page; this row is only the way in and the current answer.
    property <string> current: Settings.seed-source == SeedSourceKind.AppSeed
        ? TR2.lookup(TrId.SeedSourceAppTitle)
        : Settings.seed-source == SeedSourceKind.UserMnemonic
            ? TR2.lookup(TrId.SeedSourceMnemonicTitle)
            : TR2.lookup(TrId.SettingsSeedSourceNotSet);

    VerticalLayout {
        NavHeader {
            title: TR2.lookup(TrId.SettingsTitle);
            clicked => {
                Navigate.backward();
            }
        }

        PageBody {
            VerticalLayout {
                alignment: start;
                padding: Size.sz4;

                MenuSection {
                    title: TR2.lookup(TrId.SettingsSeedSourceTitle);
                    MenuSectionLayout {
                        MenuActionItem {
                            label: root.current;
                            first: true;
                            last: true;
                            clicked => {
                                Navigate.seed-source({ });
                            }
                        }
                    }
                }
            }
        }
    }
}
