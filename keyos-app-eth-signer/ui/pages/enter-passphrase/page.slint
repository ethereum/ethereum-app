// Apply a BIP-39 passphrase: type it, check the wallet fingerprint it leads
// to (naming its first account if it has none), or clear the applied one.

import { Theme, Images, ButtonVariant } from "@ui/theme.slint";
import { Button } from "@ui/button.slint";
import { Input } from "@ui/input.slint";
import { Spinner, SpinnerSize } from "@ui/spinner.slint";
import { TR2, TrId } from "../../gen/tr.slint";
import { Navigate } from "../../gen/navigate.slint";
import { EnterPassphrase, EnterPassphraseState } from "../../enter-passphrase.slint";
import { CreateAccount } from "../../create-account.slint";
import { Page, PageHeader, ScrollArea } from "../../components/layout.slint";
import { MutedText, Panel, PanelDivider, DetailRow } from "../../components/eth-widgets.slint";

component IdlePage inherits Page {
    PageHeader {
        title: TR2.lookup(TrId.EnterPassphraseTitle);
        action-clicked => {
            EnterPassphrase.clear-state();
            Navigate.backward();
        }
    }

    MutedText {
        text: TR2.lookup(TrId.EnterPassphraseContent);
    }

    Input {
        placeholder: TR2.lookup(TrId.EnterPassphraseFillerText);
        value: EnterPassphrase.passphrase;
        clearable: true;
        changed(text) => {
            EnterPassphrase.passphrase = text;
        }
        submitted(_text) => {
            root.dismiss-keyboard();
        }
    }

    Rectangle { vertical-stretch: 1; }

    Button {
        text: TR2.lookup(TrId.CommonButtonApply);
        full-width: true;
        clicked => {
            EnterPassphrase.try-passphrase();
            EnterPassphrase.state = EnterPassphraseState.Confirm;
        }
    }
}

component ConfirmPage inherits Page {
    property <string> new-label;
    property <string> label-error;
    property <bool> label-touched: false;
    property <bool> label-blocking: EnterPassphrase.no-accounts && (!self.label-touched || self.label-error != "");

    PageHeader {
        title: TR2.lookup(TrId.PassphraseDetailsTitle);
        action-clicked => {
            EnterPassphrase.state = EnterPassphraseState.Idle;
        }
    }

    ScrollArea {
        Panel {
            spacing: Theme.spacing-md;

            DetailRow {
                label: TR2.lookup(TrId.ConfirmPassphrasePassphrase);
                value: EnterPassphrase.passphrase;
                mono: false;
            }

            PanelDivider { }

            if !EnterPassphrase.fingerprint-loading: DetailRow {
                label: TR2.lookup(TrId.ConfirmPassphraseFingerprint);
                value: EnterPassphrase.fingerprint;
            }

            if EnterPassphrase.fingerprint-loading: HorizontalLayout {
                MutedText {
                    text: TR2.lookup(TrId.ConfirmPassphraseFingerprint);
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }

                Spinner {
                    size: SpinnerSize.sm;
                }
            }
        }

        MutedText {
            text: TR2.lookup(TrId.ConfirmPassphraseContent);
        }

        if EnterPassphrase.no-accounts: Input {
            label: TR2.lookup(TrId.ConfirmPassphraseLabelAccount0);
            placeholder: TR2.lookup(TrId.CreateAccountLabelFillerText);
            value <=> root.new-label;
            error: root.label-error;
            changed(text) => {
                root.label-touched = true;
                root.label-error = CreateAccount.validate-new-label(text);
            }
            submitted(_text) => {
                root.dismiss-keyboard();
            }
        }

        if EnterPassphrase.no-accounts: MutedText {
            text: TR2.lookup(TrId.ConfirmPassphraseLabelExplainer);
        }
    }

    Button {
        text: TR2.lookup(TrId.CommonButtonConfirm);
        full-width: true;
        disabled: root.label-blocking || EnterPassphrase.fingerprint-loading;
        clicked => {
            EnterPassphrase.slider-index = 1;
            if (root.new-label != "") {
                EnterPassphrase.create-initial-account(root.new-label);
                root.new-label = "";
            } else {
                EnterPassphrase.confirm-passphrase();
            }
        }
    }
}

component ClearPage inherits Page {
    PageHeader {
        title: TR2.lookup(TrId.PassphraseDetailsTitle);
        action-clicked => {
            Navigate.backward();
        }
    }

    Panel {
        DetailRow {
            label: TR2.lookup(TrId.ConfirmPassphraseFingerprint);
            value: EnterPassphrase.fingerprint;
        }
    }

    MutedText {
        text: TR2.lookup(TrId.ConfirmPassphraseContent);
    }

    Rectangle { vertical-stretch: 1; }

    Button {
        text: TR2.lookup(TrId.PassphraseDetailsClearPassphrase);
        start-icon: Images.icon("unlock", Theme.icon-size-md);
        full-width: true;
        clicked => {
            EnterPassphrase.clear-state();
            EnterPassphrase.clear-passphrase();
            EnterPassphrase.state = EnterPassphraseState.Idle;
            Navigate.backward();
        }
    }
}

export component EnterPassphrasePage inherits Rectangle {
    if EnterPassphrase.state == EnterPassphraseState.Idle: IdlePage {
        width: parent.width;
        height: parent.height;
    }

    if EnterPassphrase.state == EnterPassphraseState.Confirm: ConfirmPage {
        width: parent.width;
        height: parent.height;
    }

    if EnterPassphrase.state == EnterPassphraseState.Clear: ClearPage {
        width: parent.width;
        height: parent.height;
    }
}
